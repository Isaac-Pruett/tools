# Loaded for ALL zsh invocations (interactive, non-interactive, scripts).
# Keep this file minimal — only env vars that every shell needs.

export EDITOR=hx
export VISUAL=hx

[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

# npm's user-local global prefix (npm config get prefix). Put binaries
# installed via `npm install -g <pkg>` on PATH. Prepend so user-installed
# tools win over any system versions.
[ -d "$HOME/.npm-global/bin" ] && export PATH="$HOME/.npm-global/bin:$PATH"
