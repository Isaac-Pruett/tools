# ─── History ──────────────────────────────────────────────────────────────────
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE
setopt SHARE_HISTORY
setopt EXTENDED_HISTORY

# ─── Completion ───────────────────────────────────────────────────────────────
autoload -Uz compinit && compinit
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'

# ─── Nix ──────────────────────────────────────────────────────────────────────
[ -f /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh ] && \
  source /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh

# ─── Secrets ──────────────────────────────────────────────────────────────────
[ -f "$HOME/.secrets" ] && source "$HOME/.secrets"

# ─── Path ─────────────────────────────────────────────────────────────────────
export PATH="$HOME/.local/bin:$PATH"

# ─── Aliases ──────────────────────────────────────────────────────────────────
alias grep='grep --color=auto'

# eza replaces ls
alias ls='eza --icons'
alias ll='eza -la --icons --git'
alias la='eza -a --icons'
alias lt='eza --tree --icons -L 2'

# bat replaces cat
alias cat='bat --paging=never'

# ─── Zsh plugins ──────────────────────────────────────────────────────────────
# check user profile first, fall back to system (NixOS system packages)
_load_plugin() {
  for base in "$HOME/.nix-profile/share" "/run/current-system/sw/share"; do
    [ -f "$base/$1" ] && source "$base/$1" && return
  done
}
_load_plugin "zsh-autosuggestions/zsh-autosuggestions.zsh"
# zsh-syntax-highlighting must be sourced last
_load_plugin "zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
unset -f _load_plugin

# ─── Autosuggestion accept bindings ───────────────────────────────────────────
bindkey '\e[32;9u' autosuggest-accept
bindkey '\e[1;2C'  autosuggest-accept

# ─── fzf (Ctrl+T file search, Alt+C fuzzy cd — Ctrl+R handed to atuin) ───────
[ -f "$HOME/.nix-profile/share/fzf/completion.zsh" ] && \
  source "$HOME/.nix-profile/share/fzf/completion.zsh"
[ -f "$HOME/.nix-profile/share/fzf/key-bindings.zsh" ] && \
  source "$HOME/.nix-profile/share/fzf/key-bindings.zsh"

# ─── zoxide (smart cd) ────────────────────────────────────────────────────────
command -v zoxide &>/dev/null && eval "$(zoxide init zsh)"

# ─── atuin (shell history — Ctrl+R) ──────────────────────────────────────────
command -v atuin &>/dev/null && eval "$(atuin init zsh --disable-up-arrow)"

# ─── direnv ───────────────────────────────────────────────────────────────────
command -v direnv &>/dev/null && eval "$(direnv hook zsh)"

# ─── Sessionizer (Ctrl+F) ─────────────────────────────────────────────────────
bindkey -s '^f' 'sessionizer\n'

# ─── Kitty tab title (folder name at rest, "cmd  folder" while running) ──────
autoload -Uz add-zsh-hook
_tab_title_precmd()  { printf '\033]0;%s\007' "${PWD##*/}" }
_tab_title_preexec() { printf '\033]0;%s  %s\007' "${1%% *}" "${PWD##*/}" }
add-zsh-hook precmd  _tab_title_precmd
add-zsh-hook preexec _tab_title_preexec

# ─── Force blinking block cursor at every prompt ─────────────────────────────
# DECSCUSR \e[1 q = blinking block. Modal editors (Helix, LazyVim) override
# this for their own mode-aware cursor while running; the next prompt redraw
# after they exit resets us back to block-blink for the shell.
_cursor_block_blink() { printf '\e[1 q' }
add-zsh-hook precmd _cursor_block_blink
# Set once at startup too — first prompt hasn't drawn yet so precmd hasn't fired.
[[ -o interactive ]] && printf '\e[1 q'

# ─── Starship prompt ──────────────────────────────────────────────────────────
command -v starship &>/dev/null && eval "$(starship init zsh)"

# ─── Auto-attach default tmux session ────────────────────────────────────────
# New terminal windows land in a tmux session with an auto-generated
# pronounceable name (3–5 chars, alternating consonant/vowel). For specific
# work run `tx <name>` to switch into a project-defined session from
# ~/.config/sessions.toml. Run `sp` any time to bring up the fzf session
# picker. Set NO_TMUX_AUTO=1 to skip and land in plain zsh instead.
if [[ -o interactive ]] \
  && [[ -z "$TMUX" ]] \
  && [[ -z "$NO_TMUX_AUTO" ]] \
  && command -v tmux &>/dev/null; then
  _LKS_NAME=$(python3 -c '
import random
c, v = "bcdfghjklmnpqrstvw", "aeiou"
n = random.randint(3, 5)
print("".join((c if i%2==0 else v)[random.randrange(len(c if i%2==0 else v))] for i in range(n)))
' 2>/dev/null)
  if [[ -n "$_LKS_NAME" ]]; then
    while tmux has-session -t "=$_LKS_NAME" 2>/dev/null; do
      _LKS_NAME="${_LKS_NAME}$((RANDOM % 10))"
    done
    tmux new-session -A -s "$_LKS_NAME"
  fi
  unset _LKS_NAME
fi

# ─── sp — on-demand session picker (fzf over sessions.toml + live tmux) ──────
alias sp='session-picker'

# ─── tx — attach/switch by name; create with --group ──────────────────────────
# Usage:
#   tx                                       picker (no args)
#   tx <name>                                attach if exists; else picker --query
#   tx <name> --group <g>                    create new entry, attach
#                                            (group: study/tool/project/bare/utility/<any>)
#   tx <name> --group <g> --path <p>         explicit path override
#   tx <name> --group utility --cmd <c>      utility group with a command
#   tx <name> --group branch --parent <p> --branch <b> --worktree <w>
#
# Behind --group: tx-mk appends the [[session]] entry to
# ~/.config/sessions/50-scratch.toml, mkdir's the path, materializes the ctx
# dir + ctx.md, and (for non-default paths) drops a `workspace` symlink at
# ~/notebook/sessions/<group>/<name>/workspace.
tx() {
  local name= group= path= cmd= parent= branch= worktree=
  while [[ $# -gt 0 ]]; do
    case $1 in
      --group)    group=$2; shift 2 ;;
      --path)     path=$2; shift 2 ;;
      --cmd)      cmd=$2; shift 2 ;;
      --parent)   parent=$2; shift 2 ;;
      --branch)   branch=$2; shift 2 ;;
      --worktree) worktree=$2; shift 2 ;;
      --*)        echo "tx: unknown flag: $1" >&2; return 1 ;;
      *)          [ -z "$name" ] && name=$1 || { echo "tx: extra positional: $1" >&2; return 1; }
                  shift ;;
    esac
  done

  if [ -z "$name" ]; then
    session-picker
    return
  fi

  if tmux has-session -t "=$name" 2>/dev/null; then
    [ -n "$group" ] && echo "tx: session '$name' already exists; ignoring --group" >&2
    if [ -n "$TMUX" ]; then
      tmux switch-client -t "=$name"
    else
      tmux attach-session -t "=$name"
    fi
    return
  fi

  if [ -n "$group" ]; then
    local mk_args=("$name" "--group" "$group")
    [ -n "$path" ]     && mk_args+=(--path "$path")
    [ -n "$cmd" ]      && mk_args+=(--cmd "$cmd")
    [ -n "$parent" ]   && mk_args+=(--parent "$parent")
    [ -n "$branch" ]   && mk_args+=(--branch "$branch")
    [ -n "$worktree" ] && mk_args+=(--worktree "$worktree")
    tx-mk "${mk_args[@]}" || return $?
    # New entry now in 50-scratch.toml — picker direct-name path will dispatch.
    session-picker "$name"
  else
    session-picker --query "$name"
  fi
}

# ─── lks-rebase — rebase the current worktree's branch onto origin/main ──────
# Usage:
#   lks-rebase                     # uses $PWD
#   lks-rebase ~/dev/myrepo        # explicit path
# Refuses to rebase a detached HEAD. On conflicts, leaves the rebase in progress
# so you can resolve and `git rebase --continue` (or `--abort`).
lks-rebase() {
  local wt=${1:-$PWD}
  if ! git -C "$wt" rev-parse --git-dir &>/dev/null; then
    echo "lks-rebase: not a git repo: $wt" >&2
    return 1
  fi
  local branch
  branch=$(git -C "$wt" branch --show-current)
  if [ -z "$branch" ]; then
    echo "lks-rebase: detached HEAD in $wt — refusing" >&2
    return 1
  fi
  echo "→ fetching origin in $wt"
  git -C "$wt" fetch --prune origin || return 1
  echo "→ rebasing '$branch' onto origin/main"
  git -C "$wt" rebase origin/main
}

# ─── tmux-share — open a second client on an existing session ────────────────
# `tmux-share main` opens a fresh ghostty attached to a *grouped* session that
# shares all windows with `main` but tracks its own active window — so two
# monitors can sit on different windows of the same workspace.
tmux-share() {
  local s=${1:?usage: tmux-share <session>}
  if ! tmux has-session -t "$s" 2>/dev/null; then
    echo "no session named $s" >&2
    return 1
  fi
  NO_TMUX_AUTO=1 ghostty -e tmux new-session -t "$s" -s "${s}-$$" &!
}

# ─── Machine-local overrides ──────────────────────────────────────────────────
[ -f "$HOME/.zshrc.local" ] && source "$HOME/.zshrc.local"
