#!/bin/bash
# Cockpit — restore daily 3-monitor layout. Each monitor gets a tmux session
# determined by ~/.config/sessions.toml [cockpit] block:
#   monitor_1, monitor_3       pinned (e.g. agent-flow, btop)
#   monitor_2                  MRU project from ~/.cache/sessions-mru
#                              (falls back to monitor_2_default if MRU empty)
#
# Usage:
#   cockpit                    use toml defaults + MRU
#   cockpit a b c              explicit per-monitor (3 args, overrides toml)
#
# Sessions are created via session-picker so naming + branch + cwd are
# consistent with what you'd get from picking interactively.

# Note: no `set -e`. Multiple steps tolerate non-fatal failures (pkill with no
# match returns 1, session creation per slot is best-effort, etc.). Use
# explicit `|| true` where a failure is expected to be benign.

GHOSTTY_BIN=/usr/bin/ghostty
# Don't name this variable TMUX — that's tmux's own env var (socket address).
# Assigning to TMUX here would clobber the env var for every subprocess.
TMUX_BIN=/usr/bin/tmux
WMCTRL=/usr/bin/wmctrl
XDOTOOL=/usr/bin/xdotool

# Monitor geometry — auto-detected from xrandr at runtime so layout shifts
# (GNOME re-laying out after MST renumber, hub swap, etc.) don't require
# editing this file. Classifies each connected output by orientation/size:
#   * portrait (height > width) and large    → slot 0 (vertical side monitor)
#   * landscape ≥3000px wide and ≥1500px tall → slot 1 (main)
#   * everything else                         → slot 2 (built-in)
# If more than one display matches a slot, the first one wins (xrandr order).
x_pos=("" "" "")
y_pos=("" "" "")
w=("" "" "")
h=("" "" "")
while read -r geo; do
  [[ "$geo" =~ ([0-9]+)x([0-9]+)\+([0-9]+)\+([0-9]+) ]] || continue
  ww=${BASH_REMATCH[1]}; hh=${BASH_REMATCH[2]}
  xx=${BASH_REMATCH[3]}; yy=${BASH_REMATCH[4]}
  if   (( hh > ww && hh >= 3000 ));        then idx=0
  elif (( ww >= 3000 && hh >= 1500 ));     then idx=1
  else                                          idx=2
  fi
  # First-match-wins so a second portrait monitor doesn't clobber slot 0.
  [ -z "${w[$idx]}" ] && { x_pos[$idx]=$xx; y_pos[$idx]=$yy; w[$idx]=$ww; h[$idx]=$hh; }
done < <(xrandr --query | awk '/ connected/{ for(i=1;i<=NF;i++) if($i~/[0-9]+x[0-9]+\+[0-9]+\+[0-9]+/) print $i }')

echo "→ cockpit: monitor slots (slot=pos size)"
for i in 0 1 2; do
  [ -n "${w[$i]}" ] \
    && echo "    $i: (${x_pos[$i]},${y_pos[$i]}) ${w[$i]}x${h[$i]}" \
    || echo "    $i: (unfilled)"
done

# ─── Resolve which sessions land on each monitor ──────────────────────────────
if [ $# -eq 3 ]; then
  s1="$1"; s2="$2"; s3="$3"
else
  # Read [cockpit] from sessions.toml + ~/.cache/sessions-mru.
  # Filter MRU to ONLY toml-defined project/tool/branch/bare names so ad-hoc
  # pronounceable sessions (qovu, hexel, …) can never hijack monitor 2.
  read s1 s2 s3 < <(python3 - <<'PY'
import os, sys, tomllib
from pathlib import Path
cfg = Path.home() / ".config" / "sessions.toml"
mru = Path.home() / ".cache" / "sessions-mru"
full = {}
if cfg.exists():
    with open(cfg, "rb") as f:
        full = tomllib.load(f)
ck = full.get("cockpit", {})
m1 = ck.get("monitor_1", "")
m3 = ck.get("monitor_3", "")
m2_default = ck.get("monitor_2_default", "")
allowed = set()
for kind in ("tool", "project", "branch", "bare"):
    for item in full.get(kind, []):
        name = item.get("name")
        if name: allowed.add(name)
pinned = {m1, m3}
m2 = m2_default
if mru.exists():
    for line in mru.read_text().splitlines():
        name = line.strip()
        if name and name not in pinned and name in allowed:
            m2 = name; break
print(m1, m2, m3)
PY
  )
fi

sessions=("$s1" "$s2" "$s3")

# ─── Ensure each session exists (create detached if missing) ──────────────────
# --ensure tells session-picker to create + return rather than attach.
for s in "${sessions[@]}"; do
  if [ -z "$s" ]; then continue; fi
  if ! $TMUX_BIN has-session -t "=$s" 2>/dev/null; then
    if ! session-picker --ensure "$s"; then
      echo "cockpit: failed to create session '$s' — check ~/.config/sessions.toml" >&2
    fi
  fi
done

# ─── Kill prior cockpit ghostty instances before respawn ──────────────────────
pkill -f 'ghostty.*--x11-instance-name=cockpit-' 2>/dev/null || true
sleep 0.2

# ─── Spawn one ghostty per monitor; track pids for reliable window targeting ──
# Each ghostty creates two X11 windows sharing the WM_CLASS (a visible terminal
# + a hidden GTK helper). Targeting by --classname is ambiguous; --pid +
# --onlyvisible reliably finds the actual terminal window we want to position.
declare -a ghostty_pids
for i in "${!sessions[@]}"; do
  s="${sessions[$i]}"
  if [ -z "$s" ]; then continue; fi
  $GHOSTTY_BIN --gtk-single-instance=false --x11-instance-name="cockpit-mon$((i+1))" \
           -e $TMUX_BIN attach-session -t "$s" &
  ghostty_pids[$i]=$!
  sleep 0.2
done

# ─── Position each window on its monitor ──────────────────────────────────────
for i in "${!sessions[@]}"; do
  if [ -z "${sessions[$i]}" ]; then continue; fi
  pid="${ghostty_pids[$i]}"
  (
    wid=$($XDOTOOL search --sync --onlyvisible --pid "$pid" 2>/dev/null | head -1)
    if [ -z "$wid" ]; then
      echo "cockpit: no visible window found for pid $pid (mon$((i+1)))" >&2
      exit 0
    fi
    $WMCTRL -ir "$wid" -b remove,maximized_vert,maximized_horz
    $WMCTRL -ir "$wid" -e "0,${x_pos[$i]},${y_pos[$i]},${w[$i]},${h[$i]}"
    $WMCTRL -ir "$wid" -b add,maximized_vert,maximized_horz
  ) &
done

wait
