#!/usr/bin/env python3
"""focus-monitor <slot> [--class REGEX] — activate the most-recently-used window.

Slot mirrors move-to-monitor: 1/2/3 numeric or a/s/d letter:
  1 / a / L → LG ULTRAFINE     (left, vertical)
  2 / s / S → Samsung U32J59x  (center, main)
  3 / d / D → Dell built-in    (laptop panel)
  any / *   → skip monitor filter — find MRU window anywhere (used with --class)

Optional `--class REGEX` filters the stacking list to windows whose WM_CLASS
matches. Combined with a monitor slot: "MRU window of THIS class on THIS
monitor". Combined with `any`: "MRU window of THIS class anywhere". Powers
the Super+Ctrl+A/S/D terminal-focus bindings and Super+Return
(MRU-ghostty-anywhere).

Uses the X11 `_NET_CLIENT_LIST_STACKING` property: window IDs in z-order
bottom→top. Mutter raises a window to the TOP of this list on every focus,
so the topmost window inside a monitor's bbox IS the most-recently-used
window on that monitor. Silent no-op if no window matches.

EDID identifier patterns mirror move-to-monitor / restore-display-layout —
update all three in lockstep if a panel is swapped out.

Requires: xrandr, xprop, xdotool, wmctrl.
"""
import os
import re
import subprocess
import sys
import time
from pathlib import Path

# Timing-based mode switch for --cycle. If a subsequent invocation lands
# within RAPID_MS of the previous one, we assume the user is holding the
# modifier and tapping — cycle to the NEXT window after last activated.
# Otherwise treat it as a deliberate single press → jump to MRU (skipping
# the currently-focused window so a repeat isn't a no-op).
RAPID_MS = 500
CYCLE_STATE = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "focus-monitor-cycle-state"


def _read_cycle_state():
    try:
        parts = CYCLE_STATE.read_text().strip().split()
        if len(parts) == 2:
            return int(parts[0]), int(parts[1], 16)
    except Exception:
        pass
    return 0, 0


def _write_cycle_state(win_id):
    try:
        CYCLE_STATE.parent.mkdir(parents=True, exist_ok=True)
        CYCLE_STATE.write_text(f"{int(time.time() * 1000)} 0x{win_id:x}\n")
    except Exception:
        pass

EDID_PATTERNS = {
    "lg":      r"LG ULTRAFINE|512INSE5G502",
    "samsung": r"U32J59|HCRY400352",
    "builtin": r"NV14N4F",
}
# `samsung` slot falls back to "any single non-builtin external" when the
# specific Samsung EDID isn't matched — makes Super+Shift+S do the right
# thing at home too. LG has no fallback; that slot is meaningless without
# the vertical panel.
FALLBACK_TO_ANY_EXTERNAL = {"samsung"}

SLOT_MAP = {
    "1": "lg",      "a": "lg",      "l": "lg",      "L": "lg",
    "2": "samsung", "s": "samsung", "S": "samsung",
    "3": "builtin", "d": "builtin", "D": "builtin", "b": "builtin",
    # Special: any monitor — used with --class for "MRU app-window anywhere".
    "any": None, "*": None,
}


def _run(cmd):
    return subprocess.run(cmd, capture_output=True, text=True, check=True).stdout


def _decode_edid(hex_lines):
    try:
        blob = bytes.fromhex("".join(hex_lines))
    except ValueError:
        return ""
    return "".join(chr(b) if 32 <= b < 127 else " " for b in blob)


def output_for(brand):
    """xrandr output whose EDID matches the brand."""
    pattern = re.compile(EDID_PATTERNS[brand], re.IGNORECASE)
    try:
        out = _run(["xrandr", "--verbose"])
    except Exception:
        return None
    matches = []
    current_name, capturing, edid_hex = None, False, []

    def flush():
        nonlocal current_name, edid_hex
        if current_name and edid_hex:
            if pattern.search(_decode_edid(edid_hex)):
                matches.append(current_name)
        current_name, edid_hex = None, []

    for line in out.splitlines():
        m = re.match(r"^(\S+)\s+(connected|disconnected)", line)
        if m:
            flush()
            current_name = m.group(1)
            capturing = False
            continue
        if "EDID:" in line:
            capturing = True
            continue
        if capturing:
            m = re.match(r"^\s+([0-9a-fA-F]{32,})\s*$", line)
            if m:
                edid_hex.append(m.group(1))
                continue
            capturing = False
    flush()

    try:
        active = _run(["xrandr", "--listmonitors"])
    except Exception:
        active = ""
    active_outs = re.findall(r"\s(\S+)\s*$", active, flags=re.M)
    for m in matches:
        if m in active_outs:
            return m
    if matches:
        return matches[0]

    # Fallback for opt-in slots: return the first active non-builtin output
    # if no EDID-specific match was found. Lets `samsung` mean "primary
    # external" at home when the specific Samsung isn't plugged.
    if brand in FALLBACK_TO_ANY_EXTERNAL:
        builtin_output = _output_for_uncached("builtin") if "builtin" in EDID_PATTERNS else None
        for line in active.splitlines():
            m = re.match(r"^\s*\d+:\s*\+\*?(\S+)", line)
            if not m:
                continue
            name = m.group(1)
            if name and name != builtin_output:
                return name
    return None


def _output_for_uncached(brand):
    """Non-fallback lookup used by output_for's fallback to identify the
    builtin so we can exclude it when picking an arbitrary external."""
    pattern = re.compile(EDID_PATTERNS[brand], re.IGNORECASE)
    try:
        out = _run(["xrandr", "--verbose"])
    except Exception:
        return None
    current_name, capturing, edid_hex = None, False, []
    matches = []
    def flush():
        nonlocal current_name, edid_hex
        if current_name and edid_hex and pattern.search(_decode_edid(edid_hex)):
            matches.append(current_name)
        current_name, edid_hex = None, []
    for line in out.splitlines():
        m = re.match(r"^(\S+)\s+(connected|disconnected)", line)
        if m:
            flush(); current_name = m.group(1); capturing = False; continue
        if "EDID:" in line:
            capturing = True; continue
        if capturing:
            mm = re.match(r"^\s+([0-9a-fA-F]{32,})\s*$", line)
            if mm: edid_hex.append(mm.group(1)); continue
            capturing = False
    flush()
    return matches[0] if matches else None


def monitor_bbox(output_name):
    """(x, y, w, h) for an output's current mode. Tries --query first then --listmonitors."""
    try:
        out = _run(["xrandr", "--query"])
    except Exception:
        out = ""
    for line in out.splitlines():
        m = re.match(
            rf"^{re.escape(output_name)}\s+connected.*?(\d+)x(\d+)\+(\d+)\+(\d+)",
            line,
        )
        if m:
            w, h, x, y = map(int, m.groups())
            return (x, y, w, h)
    try:
        out = _run(["xrandr", "--listmonitors"])
    except Exception:
        return None
    for line in out.splitlines():
        m = re.search(
            rf"\b{re.escape(output_name)}\b\s+(\d+)(?:/\d+)?x(\d+)(?:/\d+)?\+(\d+)\+(\d+)",
            line,
        )
        if m:
            w, h, x, y = map(int, m.groups())
            return (x, y, w, h)
    return None


def _xprop_id_list(name):
    """Shared parser for xprop's WINDOW-list properties (_NET_CLIENT_LIST*)."""
    try:
        out = _run(["xprop", "-root", name])
    except Exception:
        return []
    if "#" not in out:
        return []
    return [
        int(t.strip(), 16)
        for t in out.split("#", 1)[1].split(",")
        if t.strip().startswith("0x")
    ]


def stacking_order():
    """Window IDs in z-order bottom→top (dynamic — focus raises to top)."""
    return _xprop_id_list("_NET_CLIENT_LIST_STACKING")


def creation_order():
    """Window IDs in the order they were mapped (stable — doesn't change on focus).

    We use THIS for --cycle because a stable order lets repeated presses walk
    all N matching windows. Stacking order changes every focus and so ping-pongs
    between the top two.
    """
    return _xprop_id_list("_NET_CLIENT_LIST")


def window_geometry(win_id):
    """xdotool getwindowgeometry --shell → (x, y, w, h) for absolute screen coords.

    xdotool's --shell output uses WINDOW-relative coords, NOT screen-relative.
    We use `xwininfo -id <id>` which prints `Absolute upper-left X/Y` —
    accurate for stacking-based MRU.
    """
    try:
        out = _run(["xwininfo", "-id", str(win_id)])
    except Exception:
        return None
    x = y = w = h = None
    for line in out.splitlines():
        line = line.strip()
        if line.startswith("Absolute upper-left X:"):
            x = int(line.rsplit(":", 1)[1])
        elif line.startswith("Absolute upper-left Y:"):
            y = int(line.rsplit(":", 1)[1])
        elif line.startswith("Width:"):
            w = int(line.rsplit(":", 1)[1])
        elif line.startswith("Height:"):
            h = int(line.rsplit(":", 1)[1])
    if None in (x, y, w, h):
        return None
    return (x, y, w, h)


def is_normal_window(win_id):
    """Filter out desktop/dock/menu windows — only NORMAL/DIALOG count for MRU."""
    try:
        out = _run(["xprop", "-id", str(win_id), "_NET_WM_WINDOW_TYPE"])
    except Exception:
        return False
    if "NORMAL" in out or "DIALOG" in out:
        return True
    # If property is missing, mutter treats it as NORMAL — accept.
    return "not found" in out.lower()


def center_in_bbox(geo, bbox):
    if not geo or not bbox:
        return False
    gx, gy, gw, gh = geo
    bx, by, bw, bh = bbox
    cx, cy = gx + gw // 2, gy + gh // 2
    return bx <= cx < bx + bw and by <= cy < by + bh


def activate(win_id):
    """Bring window to front + give it focus."""
    subprocess.run(["wmctrl", "-i", "-a", f"0x{win_id:x}"], check=False)


def window_class(win_id):
    """Return the WM_CLASS string for filtering. Format from xprop:
       WM_CLASS(STRING) = "instance", "class"
    We concatenate both so a regex can match either."""
    try:
        out = _run(["xprop", "-id", str(win_id), "WM_CLASS"])
    except Exception:
        return ""
    # Extract quoted parts after the = sign.
    m = re.search(r'=\s*(.+)$', out)
    if not m:
        return ""
    # Strip quotes + join the instance/class tokens.
    return re.sub(r'[",]', ' ', m.group(1))


def main():
    args = sys.argv[1:]
    if not args:
        sys.exit("Usage: focus-monitor <1|2|3|a|s|d|any> [--class REGEX]")

    # Parse optional flags.
    class_regex = None
    cycle = False
    positional = []
    i = 0
    while i < len(args):
        if args[i] == "--class" and i + 1 < len(args):
            class_regex = args[i + 1]
            i += 2
            continue
        # --cycle: walks the creation-order list to cycle across ALL matching
        # windows (not just ping-pong between the top two). --skip-focused
        # is kept as a deprecated alias for the same behavior.
        if args[i] in ("--cycle", "--skip-focused"):
            cycle = True
            i += 1
            continue
        positional.append(args[i])
        i += 1

    focused_win = None
    if cycle:
        try:
            out = _run(["xdotool", "getactivewindow"]).strip()
            focused_win = int(out) if out else None
        except Exception:
            focused_win = None

    if not positional:
        sys.exit("focus-monitor: missing slot argument")
    slot = positional[0]
    if slot not in SLOT_MAP:
        sys.exit(f"unknown slot '{slot}'")
    brand = SLOT_MAP[slot]  # None for "any" / "*"

    class_pattern = re.compile(class_regex, re.IGNORECASE) if class_regex else None

    # Resolve monitor bbox unless slot is "any".
    bbox = None
    if brand is not None:
        output = output_for(brand)
        if not output:
            sys.exit(f"focus-monitor: {brand} monitor not connected")
        bbox = monitor_bbox(output)
        if not bbox:
            sys.exit(f"focus-monitor: {output} ({brand}) has no geometry")

    def passes_filters(w):
        if not is_normal_window(w):
            return False
        if bbox is not None:
            if not center_in_bbox(window_geometry(w), bbox):
                return False
        if class_pattern is not None:
            if not class_pattern.search(window_class(w)):
                return False
        return True

    if cycle:
        matching_stable = [w for w in creation_order() if passes_filters(w)]
        if not matching_stable:
            return

        # Timing-based mode split:
        #   Rapid repeat (< RAPID_MS since last activation)  → CYCLE from last
        #   Single deliberate press                           → MRU (skip focused)
        prev_ms, prev_win = _read_cycle_state()
        now_ms = int(time.time() * 1000)
        rapid = (now_ms - prev_ms) < RAPID_MS

        target = None
        if rapid and prev_win in matching_stable:
            # Continue cycling from the window we last activated.
            idx = matching_stable.index(prev_win)
            target = matching_stable[(idx + 1) % len(matching_stable)]
        else:
            # Single-press MRU: topmost matching in stacking, skipping the
            # currently-focused window so pressing while already in a ghostty
            # jumps to the OTHER most-recent one.
            for w in reversed(stacking_order()):
                if w == focused_win:
                    continue
                if passes_filters(w):
                    target = w
                    break
            # If only the focused window matches (single ghostty), just
            # activate it — no-op vs current focus, but harmless.
            if target is None:
                for w in reversed(stacking_order()):
                    if passes_filters(w):
                        target = w
                        break
            if target is None:
                target = matching_stable[0]

        activate(target)
        _write_cycle_state(target)
        return

    # Non-cycle: walk stacking TOP→bottom (MRU) and activate first match.
    for win in reversed(stacking_order()):
        if passes_filters(win):
            activate(win)
            return
    # No matching window — silent no-op.


if __name__ == "__main__":
    main()
