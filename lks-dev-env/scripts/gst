#!/usr/bin/env bash
# gst — git status -s across every tool / project / branch worktree / bare dir
# listed in ~/.config/sessions.toml. Prints only dirs with something to show;
# clean dirs are silent. Output groups: "<path> [<branch>]" header, then the
# `git status -s` lines indented by two spaces.

paths=$(python3 - <<'PY'
import tomllib, os
from pathlib import Path
cfg_path = Path.home() / ".config" / "sessions.toml"
if not cfg_path.exists():
    raise SystemExit(0)
with open(cfg_path, "rb") as f:
    cfg = tomllib.load(f)
seen = set()
for kind, key in [("tool","path"), ("project","path"), ("branch","worktree"), ("bare","path")]:
    for item in cfg.get(kind, []):
        p = os.path.expanduser(item.get(key, ""))
        if p and p not in seen and os.path.isdir(p):
            seen.add(p); print(p)
PY
)

for path in $paths; do
  [ -e "$path/.git" ] || continue
  output=$(git -C "$path" status -s 2>/dev/null)
  if [ -n "$output" ]; then
    branch=$(git -C "$path" branch --show-current 2>/dev/null)
    printf '%s [%s]\n' "${path/#$HOME/~}" "${branch:-?}"
    printf '%s\n\n' "$output" | sed 's/^/  /'
  fi
done
