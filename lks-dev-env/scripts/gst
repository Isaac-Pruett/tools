#!/usr/bin/env bash
# gst — git status -s across every tool / project / branch worktree / bare
# entry in ~/.config/sessions.toml. Clean entries are silent.
#
# Output groups: "<name> [<branch>]" header (name comes from the toml so it
# matches `tx` and the picker), then `git status -s` indented by two spaces.
# A "(path: ~/...)" line follows when the toml name doesn't make the location
# obvious. Utility entries are skipped (no path).

python3 - <<'PY'
import os, subprocess, sys, tomllib
from pathlib import Path

CFG = Path.home() / ".config" / "sessions.toml"
HOME = str(Path.home())

if not CFG.exists():
    sys.exit(0)
with open(CFG, "rb") as f:
    cfg = tomllib.load(f)

# Iterate toml entries in their listed order; each entry contributes a (name, path) pair.
entries = []
for kind, key in [("tool","path"), ("project","path"), ("branch","worktree"), ("bare","path")]:
    for item in cfg.get(kind, []):
        name = item.get("name")
        raw = item.get(key, "")
        if not name or not raw: continue
        path = os.path.expanduser(raw)
        if not os.path.isdir(path): continue
        entries.append((name, path))

seen_paths = set()
for name, path in entries:
    if path in seen_paths: continue
    seen_paths.add(path)
    if not (os.path.exists(os.path.join(path, ".git"))):
        continue
    res = subprocess.run(
        ["git", "-C", path, "status", "-s"],
        capture_output=True, text=True
    )
    out = res.stdout.strip()
    if not out:
        continue
    branch = subprocess.run(
        ["git", "-C", path, "branch", "--show-current"],
        capture_output=True, text=True
    ).stdout.strip() or "?"
    short_path = path.replace(HOME, "~", 1)
    print(f"{name} [{branch}]  ({short_path})")
    for line in out.splitlines():
        print(f"  {line}")
    print()
PY
