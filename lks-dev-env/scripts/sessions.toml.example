# Template for ~/.config/sessions/10-canon.toml
#
# Multi-file layout — session-picker globs ~/.config/sessions/*.toml in sorted
# order; lower-numbered files take precedence on name conflict. Suggested
# layering:
#
#   10-canon.toml    public personal canon (this file). Eventually nix-generated.
#   20-work.toml     machine-local work overlay (never push to a public repo).
#   50-scratch.toml  ad-hoc sessions added by `tx --group` (auto-managed).
#   99-local.toml    private/machine-specific (never tracked).
#
# Schema — one polymorphic [[session]] table, dispatched via the `group` field:
#
#   [[session]]
#   name           required, unique tmux session name
#   group          required: tool / project / branch / bare / study / utility
#                  (or any new value — picker treats unknown as path-shaped)
#   path           optional working dir; defaults to
#                  ~/notebook/sessions/<group>/<name>/ when omitted
#   ctx            optional path to ctx.md
#   default_branch optional, for git-aware sessions
#   command        optional, for utility sessions
#   parent/worktree/branch  optional, for branch group only

# ─── Tools (personal repos) ───────────────────────────────────────────────────
[[session]]
name = "my-tool-repo"
group = "tool"
path = "~/code/my-tool-repo"
default_branch = "main"

# ─── Standalone projects ──────────────────────────────────────────────────────
[[session]]
name = "example-project"
group = "project"
path = "~/code/example-project"
default_branch = "main"

# ─── Branch subprojects (each in its own worktree) ────────────────────────────
# If the worktree dir doesn't exist, picker prints the `git worktree add`
# command needed and exits.
[[session]]
name = "feature-x"
group = "branch"
parent = "example-project"
worktree = "~/code/example-project-worktrees/feature-x"
branch = "feature/x"

# ─── Bare directories ─────────────────────────────────────────────────────────
[[session]]
name = "scratch"
group = "bare"
path = "~/scratch"

# ─── Study sessions (learning / research) ─────────────────────────────────────
# `tx <name> --group study` from the shell auto-appends entries like this to
# 50-scratch.toml. Path defaults to ~/notebook/sessions/study/<name>/ — the
# ctx dir IS the workspace for study sessions.
[[session]]
name = "example-study"
group = "study"
# path omitted → defaults to ~/notebook/sessions/study/example-study/

# ─── Utilities (run a command on session start) ───────────────────────────────
[[session]]
name = "btop"
group = "utility"
command = "btop"

# ─── Cockpit ──────────────────────────────────────────────────────────────────
# monitor_1, monitor_3 are pinned. monitor_2 uses MRU; monitor_2_default is the
# fallback used when ~/.cache/sessions-mru is empty (e.g. first run / after reboot).
[cockpit]
monitor_1 = "example-project"
monitor_2_default = "feature-x"
monitor_3 = "btop"
