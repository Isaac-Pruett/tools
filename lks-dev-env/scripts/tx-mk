#!/usr/bin/env python3
"""tx-mk — append a new [[session]] entry to ~/.config/sessions/50-scratch.toml.

Called by the `tx` zsh function when --group is passed and the named session
doesn't already exist. Materializes the ctx dir + ctx.md + (for non-default
paths) the workspace symlink at the same time, so that on the very next picker
invocation the session is ready to attach.

Usage:
  tx-mk <name> --group <g> [--path P] [--cmd C] [--parent P --branch B --worktree W]

Groups:
  study      path defaults to ~/notebook/sessions/study/<name>/   (auto-mkdir)
  tool       path defaults to ~/tools/<name>                       (auto-mkdir)
  project    path defaults to ~/dev/<name>                         (auto-mkdir)
  bare       path defaults to ~/<name>                             (auto-mkdir)
  utility    --cmd required (defaults to <name> if omitted)
  branch     --parent + --branch + --worktree all required
  <other>    path defaults to ~/notebook/sessions/<group>/<name>/  (auto-mkdir)
"""
import argparse
import os
import sys
from pathlib import Path

SCRATCH = Path.home() / ".config" / "sessions" / "50-scratch.toml"
NOTEBOOK_SESSIONS = Path.home() / "notebook" / "sessions"

DEFAULT_PATH_BY_GROUP = {
    "study":   lambda n: f"~/notebook/sessions/study/{n}",
    "tool":    lambda n: f"~/tools/{n}",
    "project": lambda n: f"~/dev/{n}",
    "bare":    lambda n: f"~/{n}",
}


def expand(p):
    return os.path.expanduser(p) if p else p


def quote_toml(s):
    """TOML string with " escapes — simple, no embedded \\ handling needed."""
    return '"' + s.replace('"', '\\"') + '"'


def main():
    ap = argparse.ArgumentParser(prog="tx-mk")
    ap.add_argument("name")
    ap.add_argument("--group", required=True)
    ap.add_argument("--path", default=None)
    ap.add_argument("--cmd", default=None)
    ap.add_argument("--parent", default=None)
    ap.add_argument("--branch", default=None)
    ap.add_argument("--worktree", default=None)
    args = ap.parse_args()

    name = args.name
    group = args.group

    lines = ["", "[[session]]", f"name = {quote_toml(name)}", f"group = {quote_toml(group)}"]

    # Default-path fall-through for unknown groups: under notebook/sessions/
    if group == "utility":
        cmd = args.cmd or name
        lines.append(f"command = {quote_toml(cmd)}")
        path = None
    elif group == "branch":
        missing = [k for k in ("parent", "branch", "worktree") if not getattr(args, k)]
        if missing:
            sys.exit(f"tx-mk: --{'/--'.join(missing)} required for branch group")
        lines.append(f"parent = {quote_toml(args.parent)}")
        lines.append(f"branch = {quote_toml(args.branch)}")
        lines.append(f"worktree = {quote_toml(args.worktree)}")
        path = None
    else:
        # Path-shaped
        path = args.path or DEFAULT_PATH_BY_GROUP.get(
            group, lambda n: f"~/notebook/sessions/{group}/{n}"
        )(name)
        lines.append(f"path = {quote_toml(path)}")

    # mkdir the working path (path-shaped groups only)
    if path:
        Path(expand(path)).mkdir(parents=True, exist_ok=True)

    # mkdir ctx dir + seed ctx.md
    ctx_dir = NOTEBOOK_SESSIONS / group / name
    ctx_dir.mkdir(parents=True, exist_ok=True)
    ctx_file = ctx_dir / "ctx.md"
    if not ctx_file.exists():
        ctx_file.write_text(f"# ctx — {name} ({group})\n")

    # Workspace symlink for path-shaped groups whose path is NOT the ctx dir.
    if path:
        path_p = Path(expand(path))
        if path_p.resolve() != ctx_dir.resolve():
            ws = ctx_dir / "workspace"
            try:
                if ws.is_symlink() or ws.exists():
                    ws.unlink()
                ws.symlink_to(path_p)
            except OSError as e:
                sys.stderr.write(f"tx-mk: workspace symlink skipped ({e})\n")

    # Append to scratch file
    SCRATCH.parent.mkdir(parents=True, exist_ok=True)
    if not SCRATCH.exists():
        SCRATCH.write_text(
            "# 50-scratch.toml — ad-hoc sessions added by `tx --group`. Edit freely;\n"
            "# this file is the same shape as 10-canon.toml. session-picker reads it\n"
            "# alongside the others. NEVER manually add work content here that\n"
            "# belongs in a machine-local file (see 20-work.toml convention).\n"
        )
    with open(SCRATCH, "a") as f:
        f.write("\n".join(lines) + "\n")

    print(f"tx-mk: added {name} ({group}) → {SCRATCH}", file=sys.stderr)
    if path:
        print(f"tx-mk: workspace {expand(path)}", file=sys.stderr)
    print(f"tx-mk: ctx       {ctx_file}", file=sys.stderr)


if __name__ == "__main__":
    main()
