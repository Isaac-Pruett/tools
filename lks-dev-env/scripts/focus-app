#!/usr/bin/env bash
# focus-app <name> — focus an app's existing window, or launch it if not running.
# Bound to Super+Z / Super+O / Super+S via the profile's gsettings.sh.

set -e

case "${1:-}" in
  zen)
    wmctrl -xa zen 2>/dev/null \
      || setsid env MOZ_ENABLE_WAYLAND=0 GDK_BACKEND=x11 /opt/zen/zen </dev/null >/dev/null 2>&1 &
    ;;
  obsidian)
    # Prefer deb-installed binary at /usr/bin/obsidian (fast cold start);
    # fall back to flatpak install if deb isn't there. The old AppImage
    # symlink path is dead and removed.
    wmctrl -xa obsidian 2>/dev/null \
      || setsid /usr/bin/obsidian </dev/null >/dev/null 2>&1 \
      || setsid flatpak run md.obsidian.Obsidian </dev/null >/dev/null 2>&1 &
    ;;
  slack)
    # Prefer deb at /usr/bin/slack (fast cold start); fall back to snap.
    # wmctrl can't raise snap-Slack's window when it's hidden to tray (GNOME
    # doesn't add unmapped windows to _NET_CLIENT_LIST); xdotool can.
    wmctrl -xa Slack 2>/dev/null \
      || xdotool search --classname "slack" windowactivate --sync 2>/dev/null \
      || setsid /usr/bin/slack </dev/null >/dev/null 2>&1 \
      || setsid /snap/bin/slack </dev/null >/dev/null 2>&1 &
    ;;
  zed)
    # WM_CLASS reports as `dev.zed.Zed` (per wmctrl -lx). Substring match works.
    # Binary symlinked at ~/.local/bin/zed → ~/.local/zed.app/bin/zed.
    wmctrl -xa dev.zed.Zed 2>/dev/null \
      || setsid "$HOME/.local/bin/zed" </dev/null >/dev/null 2>&1 &
    ;;
  *)
    echo "usage: focus-app <zen|obsidian|slack|zed>" >&2
    exit 1
    ;;
esac
