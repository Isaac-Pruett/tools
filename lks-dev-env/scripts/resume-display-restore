#!/usr/bin/env bash
# resume-display-restore — interrupt-driven daemon that re-runs
# restore-display-layout after suspend-resume or screen-unlock so the
# DP-MST chain (Samsung daisied through LG on the Dell dock) reattaches
# cleanly. Without this, post-resume/unlock the Samsung deterministically
# fails to wake — the kernel re-enumerates the MST topology in parallel
# with the NVIDIA module's resume hook, and the Samsung (leaf node, slow
# DP receiver) loses the race.
#
# Costs at rest:
#   - two dbus-monitor processes blocked on poll() — ~4 MB RAM total,
#     ZERO CPU until a signal arrives
#   - on signal arrival, an early-exit guard (xrandr --listmonitors count)
#     returns immediately when only the laptop panel is connected. The
#     restore script only runs when there's actually an external display
#     to restore.
#
# Triggers:
#   - org.freedesktop.login1.Manager.PrepareForSleep(false)  → resume
#   - org.gnome.ScreenSaver.ActiveChanged(false)             → unlock
#
# Run via the systemd user unit at ~/.config/systemd/user/resume-display-restore.service

set -u

LOG_TAG="resume-display-restore"

find_stuck_outputs() {
    # Returns names of outputs with EDID cached but no active mode in
    # listmonitors. Empty if all healthy.
    xrandr --verbose 2>/dev/null | awk '
        /^[A-Za-z0-9_-]+ (connected|disconnected)/ {
            if (name && has_edid) print name
            name=$1; has_edid=0
        }
        /EDID:/ { has_edid=1 }
        END { if (name && has_edid) print name }
    ' | while read -r out; do
        if ! xrandr --listmonitors 2>/dev/null | grep -qE " ${out}\$"; then
            echo "$out"
        fi
    done
}

force_kernel_probe() {
    # Narrow sudoers rule at /etc/sudoers.d/drm-detect allows ONLY this
    # exact command, NOPASSWD. Re-probes DP-1's MST topology.
    echo detect | sudo -n /usr/bin/tee /sys/class/drm/card1-DP-1/status >/dev/null 2>&1
}

log_state() {
    local label=$1
    {
        echo "[$label] listmonitors:"
        xrandr --listmonitors 2>&1 | sed 's/^/  /'
        echo "[$label] connected/disconnected outputs:"
        xrandr --query 2>&1 | grep -E '^(eDP|DP|HDMI)' | grep -vE 'disconnected.*\(' |
            head -10 | sed 's/^/  /'
        echo "[$label] outputs with EDID block in --verbose:"
        xrandr --verbose 2>&1 | awk '
            /^[A-Za-z0-9_-]+ (connected|disconnected)/ {
                if (name && has_edid) print "  " name " (EDID present)"
                name=$1; has_edid=0
            }
            /EDID:/ { has_edid=1 }
            END { if (name && has_edid) print "  " name " (EDID present)" }
        '
    } | logger -t "$LOG_TAG"
}

restore_if_externals() {
    # Bail fast if NO externals are connected — nothing to restore.
    n=$(xrandr --listmonitors 2>/dev/null | sed -n 's/Monitors: //p')
    edid_externals=$(xrandr --verbose 2>/dev/null |
        grep -B1 'EDID:' | grep -cE '^(DP-|HDMI-)')
    if [ "${n:-0}" -le 1 ] && [ "${edid_externals:-0}" -eq 0 ]; then
        return
    fi

    log_state "t+0s trigger"

    # Initial settle for the MST flap to start resolving.
    sleep 3

    # Poll until monitor count is stable for 3 consecutive seconds, OR a
    # 20s overall timeout. The kernel re-enumerates DP-MST asynchronously
    # after a link drop; touching xrandr too early (or worse, calling
    # `xrandr --auto`) can disable outputs that DON'T have a preferred
    # mode yet — that's how a previous version of this script accidentally
    # killed Samsung. Waiting for stability is the safe path.
    prev=""
    stable=0
    elapsed=0
    while [ $elapsed -lt 20 ]; do
        cur=$(xrandr --listmonitors 2>/dev/null | sed -n 's/Monitors: //p')
        if [ "$cur" = "$prev" ] && [ -n "$cur" ]; then
            stable=$((stable + 1))
            [ $stable -ge 3 ] && break
        else
            stable=0
        fi
        prev=$cur
        sleep 1
        elapsed=$((elapsed + 1))
    done
    logger -t "$LOG_TAG" "monitor count stable at $cur after ${elapsed}s wait"
    log_state "t+$((3 + elapsed))s after stable"

    # Detect outputs the kernel knows about (EDID cached in --verbose) but
    # that aren't in --listmonitors (no active mode). This is the MST-leaf
    # stuck case — kernel re-cached EDID but never finished re-fetching
    # the mode list after the link drop. Only the DP-1 parent's sysfs
    # status file can force a fresh probe; xrandr at user level can't.
    stuck=$(xrandr --verbose 2>/dev/null | awk '
        /^[A-Za-z0-9_-]+ (connected|disconnected)/ {
            flush(); name=$1; has_edid=0
        }
        /EDID:/ { has_edid=1 }
        END { flush() }
        function flush() {
            if (name && has_edid) print name
            name=""; has_edid=0
        }
    ' | while read -r out; do
        if ! xrandr --listmonitors 2>/dev/null | grep -qE " ${out}\$"; then
            echo "$out"
        fi
    done)

    if [ -n "$stuck" ]; then
        logger -t "$LOG_TAG" "stuck outputs detected: $stuck — forcing kernel re-probe of DP-1"
        # The sudoers rule at /etc/sudoers.d/drm-detect allows ONLY this
        # one exact command, NOPASSWD. The write triggers an MST topology
        # re-enumeration which cascades down to the leaf sub-connectors.
        if echo detect | sudo -n /usr/bin/tee /sys/class/drm/card1-DP-1/status >/dev/null 2>&1; then
            logger -t "$LOG_TAG" "sysfs probe sent — waiting for kernel re-enumeration"
            # Re-wait for stable state after the kernel re-probe.
            prev=""; stable=0; elapsed=0
            while [ $elapsed -lt 10 ]; do
                cur=$(xrandr --listmonitors 2>/dev/null | sed -n 's/Monitors: //p')
                if [ "$cur" = "$prev" ] && [ -n "$cur" ]; then
                    stable=$((stable + 1))
                    [ $stable -ge 3 ] && break
                else
                    stable=0
                fi
                prev=$cur
                sleep 1
                elapsed=$((elapsed + 1))
            done
            logger -t "$LOG_TAG" "post-probe monitor count: $cur (stable after ${elapsed}s)"
        else
            logger -t "$LOG_TAG" "sysfs probe FAILED — sudoers rule missing or wrong"
        fi
        log_state "after sysfs probe"
    fi

    # Apply EDID-keyed layout. restore-display-layout sets each panel to
    # its known-good mode + position + rotation. Safe to run even if a
    # panel is still missing — it just no-ops on what it can't see.
    "$HOME/.local/bin/restore-display-layout" 2>&1 | logger -t "$LOG_TAG"
    log_state "final"
}

# System bus — resume from suspend / hibernate
dbus-monitor --system \
    "type='signal',interface='org.freedesktop.login1.Manager',member='PrepareForSleep'" |
    while IFS= read -r line; do
        [[ "$line" == *"boolean false"* ]] && restore_if_externals &
    done &

# Session bus — GNOME ScreenSaver unlock
dbus-monitor --session \
    "type='signal',interface='org.gnome.ScreenSaver',member='ActiveChanged'" |
    while IFS= read -r line; do
        [[ "$line" == *"boolean false"* ]] && restore_if_externals &
    done &

# Session bus — mutter MonitorsChanged (hotplug, rotation, mode change).
# Catches the case where you replug a monitor and mutter's saved layout
# is wrong or missing — we apply our EDID-keyed restore-display-layout 3s
# after the topology settles. flock dedups bursts of events during a flap
# so we fire exactly once per settle window, not once per signal.
dbus-monitor --session \
    "type='signal',interface='org.gnome.Mutter.DisplayConfig',member='MonitorsChanged'" |
    while IFS= read -r line; do
        [[ "$line" == *"member=MonitorsChanged"* ]] || continue
        (
            flock -n 9 || exit 0
            sleep 3
            logger -t "$LOG_TAG" "MonitorsChanged settled — re-applying layout"
            "$HOME/.local/bin/restore-display-layout" 2>&1 | logger -t "$LOG_TAG"
        ) 9>"${XDG_RUNTIME_DIR:-/run/user/$UID}/resume-display-restore-monchanged.lock" &
    done &

# Watchdog — every 15s, check for outputs with EDID present but no active
# geometry (DP-MST leaf stuck). The post-unlock flap is oscillating: Samsung
# can come back via dbus-trigger restore, then drop again seconds later from
# kernel-side renegotiation. The dbus path fires once; the watchdog covers
# the recurring case.
#
# Backoff: after 4 consecutive probes that don't fix it (e.g. Samsung
# disconnected for real, monitor powered off, cable unplugged), stretch
# the interval to 60s. Resets immediately when state goes healthy.
{
    consecutive_misses=0
    interval=15
    while true; do
        sleep $interval
        stuck=$(find_stuck_outputs)
        if [ -n "$stuck" ]; then
            consecutive_misses=$((consecutive_misses + 1))
            logger -t "$LOG_TAG" "watchdog: stuck outputs $stuck (miss #$consecutive_misses) — probing"
            force_kernel_probe
            sleep 3
            "$HOME/.local/bin/restore-display-layout" 2>&1 | logger -t "$LOG_TAG"
            if [ $consecutive_misses -ge 4 ]; then
                interval=60
                logger -t "$LOG_TAG" "watchdog: 4+ consecutive misses, backing off to ${interval}s"
            fi
        else
            if [ $consecutive_misses -gt 0 ]; then
                logger -t "$LOG_TAG" "watchdog: state healthy, reset (was ${consecutive_misses} consecutive misses)"
            fi
            consecutive_misses=0
            interval=15
        fi
    done
} &

wait
