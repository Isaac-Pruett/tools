// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "project_panel": {
    "dock": "right",
    "default_width": 640,
  },
  "agent": {
    "dock": "left",
    "default_width": 640,
    "max_content_width": 1000,
    "favorite_models": [],
    "model_parameters": [],
    "inline_assistant_model": {
      "provider": "anthropic",
      "model": "claude-sonnet-4-6",
    },
  },
  "terminal": {
    "dock": "right",
    "default_width": 640,
    "default_height": 320,
    "copy_on_select": true,
  },
  "git_panel": {
    "dock": "right",
    "default_width": 640,
  },
  "outline_panel": {
    "dock": "right",
    "default_width": 640,
  },
  "collaboration_panel": {
    "dock": "right",
    "default_width": 640,
  },
  "agent_servers": {
    "cursor": {
      "type": "registry",
    },
    "codex-acp": {
      "type": "registry",
    },
    "claude-acp": {
      "type": "registry",
    },
  },
  "languages": {
    "Nix": {
      "language_servers": ["nixd"]
    }
  },
  "lsp": {
    "nixd": {
      "binary": {
        "path": "nixd"
      }
    }
  },
  "base_keymap": "VSCode",
  "icon_theme": "Zed (Default)",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": "One Dark Pro Glass",
  "edit_predictions": {
    "provider": "copilot",
  },
